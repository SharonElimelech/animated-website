{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "hadar-new-website",
	// Deployed as a Cloudflare Worker (npm run deploy), not Pages: the Worker needs the
	// ASSETS binding to serve pages, and pages_build_output_dir makes wrangler treat it as Pages.
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"compatibility_date": "2026-06-08",
	// Lead emails from the debt calculator. RESEND_API_KEY is a secret (set in the Cloudflare
	// dashboard / `wrangler secret put`), never in this file.
	// Sender must be on the domain verified in Resend (hadar-elimelech-law.co.il);
	// recipients are a comma-separated list.
	"vars": {
		"LEAD_NOTIFICATION_EMAIL": "aruitkh11@gmail.com,hadarelimelech.law@gmail.com",
		"LEAD_FROM_EMAIL": "Hadar Elimelech Website <leads@hadar-elimelech-law.co.il>"
	},
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "hadar-new-website"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	}
}