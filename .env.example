# --- Debt Calculator lead notifications (Resend) ---
# Copy this file to `.env.local` and fill in real values there (NOT here).
# .env.local is gitignored; .env.example is the committed template.

# Get an API key at https://resend.com (free tier available)
RESEND_API_KEY=

# Inbox that receives new leads
LEAD_NOTIFICATION_EMAIL=office@hadar-elimelech.co.il

# "From" address. Use a verified domain in Resend for production.
# For quick testing use the Resend sandbox sender below (only delivers to the
# email of the Resend account owner):
LEAD_FROM_EMAIL=Hadar Leads <onboarding@resend.dev>
